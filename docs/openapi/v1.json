        "type": "object",
        "required": [
          "id",
          "item",
          "granted",
          "notes",
          "granted_at",
          "revoked_at",
          "created_at"
        ],
        "title": "ConsentOut"
      },
      "CvAnalysisOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "cv_id": {
            "type": "string",
            "title": "Cv Id"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "type": "array",
            "title": "Checks"
          },
          "keywords": {
            "items": {
              "$ref": "#/components/schemas/KeywordStatus"
            },
            "type": "array",
            "title": "Keywords"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gaps"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "Transparent checks only. This is not a vendor ATS pass-rate score."
          }
        },
        "type": "object",
        "required": [
          "id",
          "cv_id",
          "checks",
          "keywords",
          "gaps",
          "created_at"
        ],
        "title": "CvAnalysisOut"
      },
