# Copy to .env (per app directory or repo root) and adjust.
# Never commit real secrets; .env* is git-ignored.

# development | staging | production
CF_ENVIRONMENT=development

# SQLite is fine for local dev; staging/production MUST use PostgreSQL, e.g.
CF_DATABASE_URL=sqlite:///./careerforge.db
# CF_DATABASE_URL=postgresql+psycopg://careerforge:CHANGE_ME@localhost:5432/careerforge

# JSON array of allowed browser origins (CORS)
CF_CORS_ORIGINS=["http://localhost:3000"]

# Web app (apps/web) uses CF_API_URL as the *server-side* backend target:
# CF_API_URL=http://127.0.0.1:8001
